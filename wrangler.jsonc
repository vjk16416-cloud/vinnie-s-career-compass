{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "careeros",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "send_metrics": false,
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public",
  },
  "observability": {
    "enabled": true,
  },
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs", "**/*.js"],
    },
  ],
  "env": {
    "staging": {
      "name": "careeros-staging",
    },
    "production": {
      "name": "careeros",
    },
  },
}
